{
  "manifest_version": 3,
  "name": "CP Coach",
  "version": "1.0.0",
  "description": "In-context weak-topic badges and AI recommendations for Codeforces.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.codeforces.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://codeforces.com/problemset*",
        "*://codeforces.com/contest/*/problems*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
